{
  "manifest_version": 3,
  "name": "Zora Gmail Analyzer",
  "version": "1.0.0",
  "description": "Analyze opened Gmail messages with local AI phishing detection.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
